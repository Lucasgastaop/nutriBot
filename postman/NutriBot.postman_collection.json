                  "    meals.forEach(meal => pm.expect(meal.date).to.eql(pm.collectionVariables.get('today')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refeições de ontem",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/meals?date={{yesterday}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const meals = pm.response.json();",
                  "const names = meals.map(meal => meal.foodName);",
                  "pm.test('200 com as 5 refeições de ontem', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(meals).to.have.lengthOf(5);",
                  "    ['Pão francês', 'Café sem açúcar', 'Arroz branco cozido', 'Feijão carioca cozido', 'Alcatra grelhada'].forEach(name => pm.expect(names).to.include(name));",
                  "    meals.forEach(meal => pm.expect(meal.date).to.eql(pm.collectionVariables.get('yesterday')));",
                  "});"
                ]
              }
