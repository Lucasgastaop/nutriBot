          ]
        },
        {
          "name": "Resumo de hoje",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/summary"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 com meta, consumo e saldo', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.date).to.eql(pm.collectionVariables.get('today'));",
                  "    pm.expect(body.dailyCalories).to.eql(1800);",
                  "    pm.expect(body.consumedCalories).to.be.closeTo(753.5, 1);",
                  "    pm.expect(body.remainingCalories).to.be.closeTo(1046.5, 1);",
                  "    pm.expect(body.meals).to.have.lengthOf(7);",
                  "    ['consumedCalories', 'protein', 'carbs', 'fat', 'remainingCalories'].forEach(field => pm.expect(body[field]).to.be.a('number'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Resumo de ontem",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/summary?date={{yesterday}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 do dia anterior', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.date).to.eql(pm.collectionVariables.get('yesterday'));",
                  "    pm.expect(body.meals).to.have.lengthOf(5);",
                  "    pm.expect(body.consumedCalories).to.be.above(0);",
                  "    pm.expect(body.dailyCalories).to.eql(1800);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
