              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const meals = pm.response.json();",
                  "const names = meals.map(meal => meal.foodName);",
                  "pm.test('200 com as 7 refeições de hoje', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(meals).to.have.lengthOf(7);",
